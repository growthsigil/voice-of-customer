# ─────────────────────────────────────────────────────────────────────────────
# Voice of Customer - environment variables
# Copy to `.env.local` for local dev, and set the same keys in Vercel
# (Settings → Environment Variables) for production. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) - the memory base ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Claude / Anthropic (required) - reads the calls and writes the report ──
ANTHROPIC_API_KEY=sk-ant-...
# Model that analyzes each call. Defaults to the best (claude-opus-5). Drop to a
# cheaper one (e.g. claude-sonnet-5) if you run a very high volume of calls.
VOC_ANALYSIS_MODEL=claude-opus-5
# Model that writes the weekly report. Defaults to claude-opus-5.
VOC_REPORT_MODEL=claude-opus-5

# ── Fathom (required for automatic intake) ──
# A shared secret you invent. Fathom sends it (as ?secret= or x-webhook-secret)
# so forged calls to the intake webhook are rejected.
FATHOM_WEBHOOK_SECRET=invent-a-long-random-string
# Optional: a Fathom API key. Only needed if your Fathom webhook doesn't include
# the transcript in its payload - we'll fetch it by id.
FATHOM_API_KEY=

# ── Cron / admin (required) ──
# Gates the weekly compile, the analyze sweep, and the manual ingest/compile
# endpoints. Vercel Cron sends it automatically.
CRON_SECRET=invent-a-cron-secret

# ── Context (optional but recommended) ──
# One or two paragraphs describing your offer, who you sell to, and what a call
# is for. It sharpens the analysis (so "the program" or "the audit" is understood
# in your terms). Plain text.
VOC_BUSINESS_CONTEXT=

# ── Delivery (optional) ──
# When set, you get a Telegram ping with the link each time a weekly report is
# ready. Bot via @BotFather; chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional public base URL used to build report links in pings. If unset, the
# Vercel-provided URL is used.
VOC_PUBLIC_URL=
